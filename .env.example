# Copy this file to .env and fill it in. Never commit the real .env.
# There are no API keys here on purpose — every data source we use is free
# and public, so there is nothing to run out of mid-demo.

# Which port the backend listens on
PORT=8000

# The corner coordinates of the demo area (north, south, east, west).
# This is the ONLY thing you change to move the app to a different city.
DEMO_BBOX=18.545,18.528,73.905,73.882

# Human-readable name of that area, shown in the UI and /health
DEMO_AREA_NAME=Koregaon Park, Pune

# Where the prebuilt map file, the cached places and the reports database live
GRAPH_CACHE_PATH=data/graph_cache.graphml
POI_CACHE_PATH=data/pois.json
DB_PATH=data/amparo.db

# Default position of the safety slider when the app first loads (0 = pure
# speed, 1 = pure safety)
DEFAULT_K=0.5

# Phone number the panic button dials
EMERGENCY_NUMBER=112

# What the safety slider means at its far end. At k=1, a maximally risky street
# costs this many times its length extra. Too small and the slider does nothing
# visible; too large and the "safer" route wanders absurdly.
SAFETY_WEIGHT_MAX=6.0

# Timestamps are stored as UTC and shifted by this for display. A fixed number
# rather than a timezone name, because Windows has no system timezone database
# and asking for "Asia/Kolkata" by name fails there in a confusing way.
DISPLAY_UTC_OFFSET_HOURS=5.5

# The demo button's known-good trip. Found by scanning the whole area for the
# pair with the best tradeoff: 80 m further for 43% less risk at night.
# Do not go hunting for a good example by tapping the map while people watch.
DEMO_ORIGIN=18.538960,73.897270
DEMO_DEST=18.536561,73.899698

# Set to "true" only while developing, so the frontend dev server is allowed
# to talk to the backend on a different port
ALLOW_DEV_CORS=true
